# =====================================================================
# Boti Arbitrage & Homelab Suite - Environment Configuration
# =====================================================================

# --- Discord Configuration ---
# Webhook principal para alertas de chollos (canal #chollos o similar)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Webhook secundario para telemetría, errores y alertas de salud del sistema
DISCORD_HEALTH_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_HEALTH_WEBHOOK_ID/YOUR_HEALTH_WEBHOOK_TOKEN

# Token del bot de Discord (para comandos /kits, /tasar, /radares y botones interactivos)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# IDs de servidor y canales de Discord (números enteros de Discord)
DISCORD_GUILD_ID=1564559739960959036
RELISTER_CHANNEL_ID=1565139139949764708
ALERTS_CHANNEL_ID=1564559740434911366
ALERT_USER_ID=

# --- IA & Modelos de Visión / Análisis ---
# Google Gemini API Key (Recomendado: gemini-3.5-flash-lite)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# OpenRouter API Key (Fallback alternativo)
OPENROUTER_API_KEY=

# Modelos a utilizar (Flash-Lite / Mini para contención estricta de costes)
AI_MODEL=gemini-3.5-flash-lite
AI_ANALYST_MODEL=gemini-3.5-flash-lite
AI_PRESCREEN_MODEL=gemini-3.5-flash-lite

# Presupuesto diario de IA en USD (Cortafuegos estricto a 0.10$/día)
AI_DAILY_BUDGET_USD=0.10

# Concurrencia máxima simultánea de llamadas a la API de IA (evita 429s y picos)
AI_MAX_CONCURRENCY=3

# Modo shadow para la Puerta 1 de criba de texto (true = registra lo que descartaría sin descartar, false = descarte activo)
AI_PRESCREEN_SHADOW_MODE=false

# --- Configuración Operativa ---
# Ciudad por defecto para cálculo de envíos / reventa local
SELLER_CITY=Sevilla

# Proxy opcional (HTTP / SOCKS5) para peticiones de scraping
PROXY_URL=

# Intervalos de escaneo en segundos (también configurables en docker-compose.yml)
SCAN_INTERVAL_SECONDS=8
VINTED_SCAN_INTERVAL_SECONDS=45
MULTI_SCAN_INTERVAL_SECONDS=45

# --- Alertas Push 1-Tap (ntfy.sh & Telegram) ---
# URL del topic privado de ntfy.sh para apertura instantánea en 1 toque al pulsar la notificación
NTFY_TOPIC_URL=https://ntfy.sh/sniper_chollos_privado_xxxx

# Telegram Bot (Opcional para canal o grupo privado con botones Inline)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rutas del contenedor (generalmente no modificar si se corre en Docker)
# DB_PATH=/app/data/sniper.db
# CONFIG_PATH=/app/config.json
# KITS_DIR=/app/kits

